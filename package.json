{
  "name": "little-worlds-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/arcade.test.js tests/animation.test.js tests/progression.test.js tests/records.test.js tests/native-art.test.js tests/party-games.test.js && node tests/game.cjs",
    "test:browser": "node --require ./tests/background-browser.cjs tests/browser-smoke.cjs",
    "format": "prettier --write src index.html sprite-lab.html vite.config.js tests/*.js tests/*.cjs README.md package.json .github/workflows/*.yml",
    "test:pixels": "node --require ./tests/background-browser.cjs tests/pixel-grid.cjs",
    "test:animation": "node --require ./tests/background-browser.cjs tests/animation-browser.cjs",
    "prepare:art": "node --require ./tests/background-browser.cjs tests/prepare-art.cjs",
    "test:victory": "node --require ./tests/background-browser.cjs tests/victory-browser.cjs",
    "test:input": "node --require ./tests/background-browser.cjs tests/input-browser.cjs",
    "test:audio": "node --require ./tests/background-browser.cjs tests/audio-browser.cjs",
    "test:render": "node --require ./tests/background-browser.cjs tests/render-soak.cjs",
    "test:journey": "node --require ./tests/background-browser.cjs tests/journey-browser.cjs",
    "test:platform": "node --require ./tests/background-browser.cjs tests/platform-browser.cjs",
    "test:arcade-journey": "node --require ./tests/background-browser.cjs tests/arcade-journey.cjs",
    "test:cross-browser": "node --require ./tests/background-browser.cjs tests/cross-browser.cjs",
    "test:assets": "node --require ./tests/background-browser.cjs tests/assets-browser.cjs",
    "test:controller": "node --require ./tests/background-browser.cjs tests/controller-shelf.cjs",
    "test:campaign": "node --require ./tests/background-browser.cjs tests/campaign-browser.cjs",
    "test:coop": "node --require ./tests/background-browser.cjs tests/coop-browser.cjs",
    "test:meadow": "node --require ./tests/background-browser.cjs tests/meadow-browser.cjs",
    "test:discoveries": "node --require ./tests/background-browser.cjs tests/discoveries-browser.cjs",
    "test:deployment": "node --require ./tests/background-browser.cjs tests/deployment-browser.cjs",
    "test:summit": "node --require ./tests/background-browser.cjs tests/summit-browser.cjs",
    "test:fullscreen": "node --require ./tests/background-browser.cjs tests/fullscreen-browser.cjs",
    "test:party": "node --require ./tests/background-browser.cjs tests/party-browser.cjs",
    "test:bricks": "node --require ./tests/background-browser.cjs tests/bricks-browser.cjs",
    "prepare:worlds": "node --require ./tests/background-browser.cjs tests/prepare-generated-worlds.cjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.7"
  }
}
