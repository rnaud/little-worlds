    "test:animation": "node tests/animation-browser.cjs",
    "prepare:art": "node tests/prepare-art.cjs",
    "test:victory": "node tests/victory-browser.cjs",
    "test:input": "node tests/input-browser.cjs",
    "test:audio": "node tests/audio-browser.cjs",
    "test:render": "node tests/render-soak.cjs",
    "test:journey": "node tests/journey-browser.cjs",
    "test:platform": "node tests/platform-browser.cjs",
    "test:arcade-journey": "node tests/arcade-journey.cjs",
    "test:cross-browser": "node tests/cross-browser.cjs",
    "test:assets": "node tests/assets-browser.cjs",
    "test:controller": "node tests/controller-shelf.cjs",
    "test:campaign": "node tests/campaign-browser.cjs",
    "test:coop": "node tests/coop-browser.cjs",
    "test:meadow": "node tests/meadow-browser.cjs",
